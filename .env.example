# AURA Platform Environment Configuration
# Copy this file to .env and insert your real API keys

# Google Gemini API Key (used by LangGraph multi-agent LLM reasoning)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (used by JEV risk assessment engine)
OPENROUTER_API_KEY=your_openrouter_api_key_here

