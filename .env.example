# ==============================================================================
# AURA Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Just-in-Time Evaluation Validator (JEV) API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key for GeminiJEV (uses google-genai SDK)
# Required only if running live Gemini JEV instead of MockJEV
GEMINI_API_KEY=

# OpenRouter API Key for OpenRouterJEV (cross-model validation fallback)
# Required only if running live OpenRouter JEV
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Evaluation & Telemetry Sinks
# ------------------------------------------------------------------------------
# Humanloop API Key for decoupled evaluation logging and human feedback
# (Optional: runs as a fire-and-forget sink, never on the critical path)
HUMANLOOP_API_KEY=

# ------------------------------------------------------------------------------
# 3. Gateway Runtime Settings
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production
AURA_ENV=development

# Authoritative SQLite database file path for audit logs and idempotency store
AURA_DB_PATH=aura.db

# Path to the directory containing policy.yaml, agents.yaml, and resources.yaml
AURA_CONFIG_DIR=config

# Gateway logging verbosity: DEBUG | INFO | WARNING | ERROR
AURA_LOG_LEVEL=INFO

